{
  "name": "wiz-controller",
  "version": "2.0.0",
  "private": true,
  "description": "Scene-based light show controller for WiZ, Magic Home and Arduino lamps on the local network",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"yarn dev:server\" \"yarn dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "yarn --cwd web dev",
    "dev:sim": "DRIVERS=none yarn dev",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "magic-home": "^2.9.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
